# Final HBOS target. This intentionally becomes valid only after the pinned
# Chromium tree has the target_os="hbos" and Ozone HBOS platform patches.
target_os = "hbos"
target_cpu = "x64"
is_debug = false
is_component_build = false
is_official_build = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
use_remoteexec = false
use_siso = false
use_ozone = true
ozone_auto_platforms = false
ozone_platform = "hbos"
ozone_platform_headless = false
use_cups = false
use_pulseaudio = false
rtc_use_pipewire = false
enable_remoting = false
enable_widevine = false
# H.264/AAC 必须打开：B 站主码流是 H.264，关掉 propriptary_codecs 之后
# MediaSource.isTypeSupported('avc1...') 直接返回 false，G4 验收无从谈起。
# args.host.gn 一直是开的，两边保持一致，避免"参考壳能播、目标壳不能"的
# 诡异现象。
proprietary_codecs = true
ffmpeg_branding = "Chrome"
